import React from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { AlertTriangle, TrendingUp, Eye, Share2, ExternalLink } from "lucide-react";
import { format } from "date-fns";
import { motion } from "framer-motion";

export default function TrendingAlertCard({ check, index, onViewDetails }) {
  const getAlertSeverity = (score, verdict) => {
    if (verdict === "false" || score < 30) {
      return { color: "text-red-600", bg: "bg-red-50", border: "border-red-200", label: "High Risk" };
    }
    if (verdict === "misleading" || score < 60) {
      return { color: "text-amber-600", bg: "bg-amber-50", border: "border-amber-200", label: "Medium Risk" };
    }
    return { color: "text-blue-600", bg: "bg-blue-50", border: "border-blue-200", label: "Low Risk" };
  };

  const severity = getAlertSeverity(check.credibility_score, check.verdict);

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      transition={{ delay: index * 0.1, duration: 0.3 }}
    >
      <Card className={`border-2 ${severity.border} hover:shadow-xl transition-all duration-300`}>
        <CardContent className="p-6">
          <div className="flex items-start gap-4">
            {/* Alert Icon */}
            <div className={`w-14 h-14 ${severity.bg} rounded-2xl flex items-center justify-center flex-shrink-0`}>
              <AlertTriangle className={`w-7 h-7 ${severity.color}`} />
            </div>

            {/* Content */}
            <div className="flex-1 min-w-0">
              <div className="flex items-start justify-between gap-4 mb-3">
                <h3 className="font-bold text-lg text-slate-900 line-clamp-2">
                  {check.title || "Trending Content Alert"}
                </h3>
                <Badge className={`${severity.bg} ${severity.color} border ${severity.border} flex-shrink-0`}>
                  {severity.label}
                </Badge>
              </div>

              {/* Metrics */}
              <div className="flex items-center gap-6 mb-4">
                <div className="flex items-center gap-2">
                  <TrendingUp className="w-4 h-4 text-slate-500" />
                  <span className="text-sm font-semibold text-slate-900">{check.viral_score}/100</span>
                  <span className="text-xs text-slate-500">Viral Score</span>
                </div>
                <div className="flex items-center gap-2">
                  <Eye className="w-4 h-4 text-slate-500" />
                  <span className="text-sm font-medium text-slate-700">
                    {check.engagement_metrics?.views?.toLocaleString() || 0} views
                  </span>
                </div>
                <div className="flex items-center gap-2">
                  <Share2 className="w-4 h-4 text-slate-500" />
                  <span className="text-sm font-medium text-slate-700">
                    {check.engagement_metrics?.shares?.toLocaleString() || 0} shares
                  </span>
                </div>
              </div>

              {/* Analysis Preview */}
              <p className="text-sm text-slate-600 mb-4 line-clamp-2">
                {check.ai_analysis}
              </p>

              {/* Footer */}
              <div className="flex items-center justify-between pt-4 border-t border-slate-200">
                <div className="flex items-center gap-3">
                  <Badge variant="outline" className="text-xs">{check.platform}</Badge>
                  <span className="text-xs text-slate-500">
                    {format(new Date(check.created_date), "MMM d, h:mm a")}
                  </span>
                </div>
                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => window.open(check.url, "_blank")}
                    className="rounded-lg"
                  >
                    <ExternalLink className="w-3 h-3 mr-1" />
                    View
                  </Button>
                  <Button
                    size="sm"
                    onClick={() => onViewDetails(check)}
                    className="bg-blue-600 hover:bg-blue-700 rounded-lg"
                  >
                    Details
                  </Button>
                </div>
              </div>
            </div>

            {/* Score Badge */}
            <div className="text-center flex-shrink-0">
              <div className="text-3xl font-bold text-slate-900">{check.credibility_score}</div>
              <div className="text-xs text-slate-500 font-medium">Score</div>
            </div>
          </div>
        </CardContent>
      </Card>
    </motion.div>
  );
}