export default function CredibilityResult({ result, onReport }) {
  const [shareSuccess, setShareSuccess] = useState(false);

  const getVerdictConfig = (verdict) => {
    switch (verdict) {
      case "verified":
        return {
          icon: CheckCircle2,
          label: "Verified True",
          color: "text-emerald-600",
          bgColor: "bg-emerald-50",
          borderColor: "border-emerald-200",
          gradient: "from-emerald-500 to-emerald-600",
        };
      case "misleading":
        return {
          icon: AlertTriangle,
          label: "Misleading",
          color: "text-amber-600",
          bgColor: "bg-amber-50",
          borderColor: "border-amber-200",
          gradient: "from-amber-500 to-amber-600",
        };
      case "false":
        return {
          icon: XCircle,
          label: "False Information",
          color: "text-red-600",
          bgColor: "bg-red-50",
          borderColor: "border-red-200",
          gradient: "from-red-500 to-red-600",
        };
      default:
        return {
          icon: AlertTriangle,
          label: "Unverified",
          color: "text-slate-600",
          bgColor: "bg-slate-50",
          borderColor: "border-slate-200",
          gradient: "from-slate-500 to-slate-600",
        };
    }
  };

  const config = getVerdictConfig(result.verdict);
  const VerdictIcon = config.icon;
  const isTextVerification = result.verification_type === "text";
  const isImageVerification = result.verification_type === "image";

  const handleShare = () => {
    // Assuming result.id exists for a unique shareable link
    const shareUrl = `${window.location.origin}${window.location.pathname}?check=${result.id}`;
    navigator.clipboard.writeText(shareUrl);
    setShareSuccess(true);
    setTimeout(() => setShareSuccess(false), 2000);
  };

  const handleDownload = () => {
    // Create a simple text report
    const report = `
TruthShield Verification Report
================================

Title: ${result.title || 'N/A'}
Verdict: ${result.verdict || 'N/A'}
Credibility Score: ${result.credibility_score || 'N/A'}/100
Date: ${new Date().toLocaleDateString()}

${result.content_text ? `Original Content:\n"${result.content_text}"\n` : ''}
${result.image_url ? `Analyzed Image: ${result.image_url}\n` : ''}

AI Analysis:
${result.ai_analysis || 'No detailed AI analysis available.'}

${result.key_claims && result.key_claims.length > 0 ?
  `Key Claims:\n${result.key_claims.map((claim, index) => `- Claim ${index + 1}: ${claim.claim} (${claim.verdict})`).join('\n')}\n` : ''}

${result.sources && result.sources.length > 0 ?
  `Sources:\n${result.sources.map(s => `- ${s.name}: ${s.url} (Credibility: ${s.credibility})`).join('\n')}` : ''}
    `.trim();

    const blob = new Blob([report], { type: 'text/plain' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `truthshield-report-${result.id || Date.now()}.txt`;
    document.body.appendChild(a); // Append to body to ensure it's clickable
    a.click();
    document.body.removeChild(a); // Clean up
    window.URL.revokeObjectURL(url); // Release object URL
  };

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      transition={{ duration: 0.4 }}
      className="space-y-6"
    >
      {/* Main Result Card */}
      <Card className={`border-2 ${config.borderColor} shadow-xl`}>
        <CardHeader className={`${config.bgColor} border-b ${config.borderColor}`}>
          <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div className="flex items-start gap-4 flex-1">
              <div className={`w-14 h-14 bg-gradient-to-br ${config.gradient} rounded-2xl flex items-center justify-center shadow-lg flex-shrink-0`}>
                <VerdictIcon className="w-8 h-8 text-white" />
              </div>
              <div className="flex-1">
                <div className="flex items-center gap-3 mb-2 flex-wrap">
                  <Badge className={`${config.bgColor} ${config.color} border ${config.borderColor} text-sm font-semibold px-4 py-1`}>
                    {config.label}
                  </Badge>
                  {/* New badge for confidence */}
                  <Badge className="bg-blue-100 text-blue-800 border-blue-200 px-3 py-1">
                    {result.confidence_score || 95}% Confident
                  </Badge>
                  <Badge variant="outline" className="bg-slate-50 text-slate-700 border-slate-200">
                    {isImageVerification ? (
                      <>
                        <ImageIcon className="w-3 h-3 mr-1" />
                        Image Verification
                      </>
                    ) : isTextVerification ? (
                      <>
                        <FileText className="w-3 h-3 mr-1" />
                        Text Verification
                      </>
                    ) : (
                      <>
                        <LinkIcon className="w-3 h-3 mr-1" />
                        URL Verification
                      </>
                    )}
                  </Badge>
                  {result.is_trending && (
                    <Badge variant="outline" className="bg-orange-50 text-orange-700 border-orange-200">
                      <TrendingUp className="w-3 h-3 mr-1" />
                      Trending
                    </Badge>
                  )}
                </div>
                <CardTitle className="text-2xl font-bold text-slate-900 leading-tight">
                  {result.title || "Content Analysis Complete"}
                </CardTitle>
              </div>
            </div>
            
            {/* Circular Progress */}
            <div className="flex-shrink-0">
              <CircularProgress score={result.credibility_score} />
            </div>
          </div>
        </CardHeader>

        <CardContent className="p-8 space-y-8">
          {/* Image Preview (for image verification) */}
          {isImageVerification && result.image_url && (
            <div>
              <h3 className="text-lg font-bold text-slate-900 mb-3">Analyzed Image</h3>
              <img
                src={result.image_url}
                alt="Analyzed content"
                className="w-full max-h-96 object-contain rounded-xl border-2 border-slate-200"
              />
            </div>
          )}

          {/* AI Generation Detection (for images) */}
          {isImageVerification && (
            <div className="grid md:grid-cols-2 gap-4">
              <Card className={`border-2 ${result.is_ai_generated ? 'border-purple-200 bg-purple-50' : 'border-emerald-200 bg-emerald-50'}`}>
                <CardContent className="p-6">
                  <div className="flex items-center gap-3 mb-3">
                    <Sparkles className={`w-6 h-6 ${result.is_ai_generated ? 'text-purple-600' : 'text-emerald-600'}`} />
                    <h4 className="font-bold text-slate-900">AI Generation Detection</h4>
                  </div>
                  <div className="space-y-2">
                    <div className="flex items-center justify-between">
                      <span className="text-sm font-medium text-slate-700">Status:</span>
                      <Badge className={result.is_ai_generated ? 'bg-purple-100 text-purple-800' : 'bg-emerald-100 text-emerald-800'}>
                        {result.is_ai_generated ? 'AI Generated' : 'Real Image'}
                      </Badge>
                    </div>
                    <div className="flex items-center justify-between">
                      <span className="text-sm font-medium text-slate-700">Confidence:</span>
                      <span className="text-lg font-bold text-slate-900">{result.ai_generation_confidence || 0}%</span>
                    </div>
                    <div className="h-2 bg-slate-200 rounded-full overflow-hidden mt-3">
                      <motion.div
                        initial={{ width: 0 }}
                        animate={{ width: `${result.ai_generation_confidence || 0}%` }}
                        transition={{ duration: 1, ease: "easeOut" }}
                        className={`h-full ${result.is_ai_generated ? 'bg-gradient-to-r from-purple-500 to-purple-600' : 'bg-gradient-to-r from-emerald-500 to-emerald-600'} rounded-full`}
                      />
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card className={`border-2 ${result.image_manipulation_detected ? 'border-orange-200 bg-orange-50' : 'border-blue-200 bg-blue-50'}`}>
                <CardContent className="p-6">
                  <div className="flex items-center gap-3 mb-3">
                    <AlertCircle className={`w-6 h-6 ${result.image_manipulation_detected ? 'text-orange-600' : 'text-blue-600'}`} />
                    <h4 className="font-bold text-slate-900">Manipulation Detection</h4>
                  </div>
                  <div className="space-y-2">
                    <div className="flex items-center justify-between">
                      <span className="text-sm font-medium text-slate-700">Status:</span>
                      <Badge className={result.image_manipulation_detected ? 'bg-orange-100 text-orange-800' : 'bg-blue-100 text-blue-800'}>
                        {result.image_manipulation_detected ? 'Manipulation Detected' : 'No Manipulation'}
                      </Badge>
                    </div>
                    <p className="text-sm text-slate-700 mt-3">
                      {result.image_manipulation_detected 
                        ? 'Signs of editing or manipulation were found in this image.'
                        : 'No signs of significant editing or manipulation detected.'}
                    </p>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}

          {/* Fact Checker Badges */}
          <FactCheckerBadges />

          {/* Original Content (for text verification) */}
          {isTextVerification && result.content_text && (
            <div>
              <h3 className="text-lg font-bold text-slate-900 mb-3">Original Content</h3>
              <div className="p-5 bg-slate-50 rounded-xl border border-slate-200">
                <p className="text-slate-700 leading-relaxed italic">"{result.content_text}"</p>
              </div>
            </div>
          )}

          {/* First Appeared & Spread Analysis */}
          {!isTextVerification && !isImageVerification && result.created_date && ( // Added result.created_date check
            <div className="grid md:grid-cols-2 gap-4">
              <div className="p-4 bg-slate-50 rounded-xl">
                <h4 className="text-sm font-semibold text-slate-700 mb-2">First Appeared</h4>
                <p className="text-lg font-bold text-slate-900">
                  {new Date(result.created_date).toLocaleDateString('en-US', { 
                    month: 'long', 
                    day: 'numeric', 
                    year: 'numeric' 
                  })}
                </p>
                <p className="text-xs text-slate-600 mt-1">
                  Detected across multiple platforms
                </p>
              </div>
              <div className="p-4 bg-slate-50 rounded-xl">
                <h4 className="text-sm font-semibold text-slate-700 mb-2">Spread Analysis</h4>
                <div className="flex gap-2 mt-2">
                  <Badge variant="outline" className="bg-red-50 text-red-700 border-red-200">
                    <Youtube className="w-3 h-3 mr-1" />
                    YouTube
                  </Badge>
                  <Badge variant="outline" className="bg-blue-50 text-blue-700 border-blue-200">
                    <Twitter className="w-3 h-3 mr-1" />
                    Twitter
                  </Badge>
                </div>
              </div>
            </div>
          )}

          {/* Credibility Score Visual */}
          <div>
            <div className="flex items-center justify-between mb-3">
              <span className="text-sm font-semibold text-slate-700">Credibility Analysis</span>
              <span className="text-sm font-medium text-slate-600">{result.credibility_score}/100</span>
            </div>
            <div className="h-3 bg-slate-100 rounded-full overflow-hidden">
              <motion.div
                initial={{ width: 0 }}
                animate={{ width: `${result.credibility_score}%` }}
                transition={{ duration: 1, ease: "easeOut" }}
                className={`h-full bg-gradient-to-r ${config.gradient} rounded-full`}
              />
            </div>
          </div>

          {/* AI Analysis */}
          <div>
            <h3 className="text-lg font-bold text-slate-900 mb-3">AI Analysis</h3>
            <p className="text-slate-700 leading-relaxed">{result.ai_analysis}</p>
          </div>

          {/* Key Claims */}
          {result.key_claims && result.key_claims.length > 0 && (
            <div>
              <h3 className="text-lg font-bold text-slate-900 mb-4">Key Claims Analyzed</h3>
              <div className="space-y-3">
                {result.key_claims.map((claim, index) => {
                  const claimConfig = getVerdictConfig(claim.verdict);
                  return (
                    <div key={index} className="flex items-start gap-3 p-4 bg-slate-50 rounded-xl">
                      <claimConfig.icon className={`w-5 h-5 ${claimConfig.color} flex-shrink-0 mt-0.5`} />
                      <div className="flex-1">
                        <p className="text-sm font-medium text-slate-900">{claim.claim}</p>
                        <Badge className={`${claimConfig.bgColor} ${claimConfig.color} border ${claimConfig.borderColor} text-xs mt-2`}>
                          {claim.verdict}
                        </Badge>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Sources */}
          {result.sources && result.sources.length > 0 && (
            <div>
              <h3 className="text-lg font-bold text-slate-900 mb-4">Supporting Sources</h3>
              <div className="space-y-2">
                {result.sources.map((source, index) => (
                  <a
                    key={index}
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center justify-between p-4 bg-blue-50 hover:bg-blue-100 rounded-xl transition-colors duration-200 group"
                  >
                    <div className="flex items-center gap-3">
                      <div className="w-2 h-2 rounded-full bg-blue-500" />
                      <span className="font-medium text-slate-900">{source.name}</span>
                      <Badge variant="outline" className="text-xs">
                        {source.credibility} credibility
                      </Badge>
                    </div>
                    <ExternalLink className="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors" />
                  </a>
                ))}
              </div>
            </div>
          )}

          {/* Engagement Metrics (only for URL verification) */}
          {!isTextVerification && !isImageVerification && result.engagement_metrics && (
            <div className="grid grid-cols-3 gap-4 p-6 bg-gradient-to-r from-slate-50 to-slate-100 rounded-2xl">
              <div className="text-center">
                <div className="flex items-center justify-center gap-2 mb-2">
                  <Eye className="w-5 h-5 text-slate-600" />
                </div>
                <div className="text-2xl font-bold text-slate-900">
                  {result.engagement_metrics.views?.toLocaleString() || 0}
                </div>
                <div className="text-sm text-slate-600 font-medium">Views</div>
              </div>
              <div className="text-center">
                <div className="flex items-center justify-center gap-2 mb-2">
                  <Share2 className="w-5 h-5 text-slate-600" />
                </div>
                <div className="text-2xl font-bold text-slate-900">
                  {result.engagement_metrics.shares?.toLocaleString() || 0}
                </div>
                <div className="text-sm text-slate-600 font-medium">Shares</div>
              </div>
              <div className="text-center">
                <div className="flex items-center justify-center gap-2 mb-2">
                  <MessageCircle className="w-5 h-5 text-slate-600" />
                </div>
                <div className="text-2xl font-bold text-slate-900">
                  {result.engagement_metrics.comments?.toLocaleString() || 0}
                </div>
                <div className="text-sm text-slate-600 font-medium">Comments</div>
              </div>
            </div>
          )}

          {/* Action Buttons */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-3 pt-4 border-t border-slate-200">
            {result.url && (
              <Button
                variant="outline"
                onClick={() => window.open(result.url, "_blank")}
                className="rounded-xl"
              >
                <ExternalLink className="w-4 h-4 mr-2" />
