import React from "react";
import { motion } from "framer-motion";
import { Badge } from "@/components/ui/badge";
import { CheckCircle } from "lucide-react";

export default function FactCheckerBadges() {
  const factCheckers = [
    { name: "Snopes", verified: true },
    { name: "PolitiFact", verified: true },
    { name: "AFP Fact Check", verified: true },
    { name: "Alt News", verified: true }
  ];

  return (
    <div className="space-y-3">
      <h4 className="text-sm font-semibold text-slate-700 flex items-center gap-2">
        <CheckCircle className="w-4 h-4 text-emerald-600" />
        Consulted Fact-Checkers
      </h4>
      <div className="flex flex-wrap gap-2">
        {factCheckers.map((checker, index) => (
          <motion.div
            key={checker.name}
            initial={{ opacity: 0, scale: 0.8 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ delay: 0.6 + index * 0.1, duration: 0.3 }}
          >
            <Badge 
              variant="outline" 
              className="bg-emerald-50 text-emerald-700 border-emerald-200 px-3 py-1"
            >
              <CheckCircle className="w-3 h-3 mr-1" />
              {checker.name}
            </Badge>
          </motion.div>
        ))}
      </div>
    </div>
  );
}